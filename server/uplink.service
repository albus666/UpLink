[Unit]
Description=uplink remote API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/uplink/server
EnvironmentFile=/opt/uplink/server/.env
ExecStart=/opt/uplink/server/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8787
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
