# 手机登录用的共享口令，至少 16 位。不要提交真实值。
APP_TOKEN=please-change-this-token

# Agent 只能改这个目录里的文件（建议指向一个 git 仓库）
WORKSPACE=../workspace

# Cursor API Key：Dashboard → Integrations / API Keys
CURSOR_API_KEY=

# 可选
HOST=0.0.0.0
PORT=8787
AGENT_BIN=agent
AGENT_MODEL=composer-2.5
AGENT_TIMEOUT_SEC=1800
MAX_UPLOAD_MB=50
DATA_DIR=./data
CORS_ORIGINS=*
